# EmailJS (https://dashboard.emailjs.com) — le service utilisé est service_aetdzq2.
# Copie ce fichier en `.env` puis renseigne :
#   - la clé publique : Account > General > Public Key
#   - l'ID du modèle « Contact us » (le message que tu reçois)
#   - l'ID du modèle « Réponse automatique » (l'accusé envoyé à la personne)
# Les modèles HTML sont dans emailjs/templates.html.
# Sans ces valeurs, le formulaire ouvre le client mail (mailto:).
VITE_EMAILJS_PUBLIC_KEY=service_a492anr
VITE_EMAILJS_CONTACT_TEMPLATE=template_9npwbxe
VITE_EMAILJS_REPLY_TEMPLATE=template_opz8etl
